      "jobSummaryDisplay": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><b><i>JOB SUMMARY: &nbsp;</i></b></span></span></p>\r\n\r\n<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><span style=\"layout-grid-mode:line\">Working independently, has the administrative responsibility for fiscal management, human resources, quality improvement programs, planning, organizing, directing, controlling, coordinating and promoting the Obstetrical, (LDR, Post Partum/Nursery), Level II Nursery, Pediatric and Childbirth Education areas in the delivery of patient care.</span></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><b><i>EDUCATION AND RELATED EXPERIENCE:</i></b></span></span></p>\r\n\r\n<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><b>Required: </b></span></span></p>\r\n\r\n<ul>\r\n\t<li><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Master&rsquo;s Degree in nursing or healthcare administration.</span></span></li>\r\n\t<li><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Five years&rsquo; experience in the Maternal Child Health areas of an acute care</span></span>&nbsp;<span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">hospital, with three years of progressively more complex administrative &nbsp;responsibility.</span></span></li>\r\n</ul>\r\n\r\n<p style=\"margin-left:25px\">&nbsp;</p>\r\n",
