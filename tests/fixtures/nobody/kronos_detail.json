dir=\"ltr\">\n<p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:10pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Northern $elect Retirement Plan (403(b) and 457(b)) and Roth IRA</span></p>\n</li><li dir=\"ltr\">\n<p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:10pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Celebrate! - Pick a gift to recognize your fifth anniversary and every five years of service thereafter</span></p>\n</li><li dir=\"ltr\">\n<p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:10pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Employee discount programs</span></p>\n</li><li dir=\"ltr\">\n<p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:24pt\"><span style=\"font-size:10pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Employee Health Clinic</span></p>\n</li></ul>",
 "job_requirement": "<p dir=\"ltr\" style=\"line-height:1.714284;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:bold;font-style:normal;font-variant:normal;text-decoration:underline;vertical-align:baseline;white-space:pre-wrap\">PATIENT CARE TECH:</span><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:bold;font-style:normal;font-variant:normal;text-decoration:underline;vertical-align:baseline;white-space:pre-wrap\"><br /></span><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:underline;vertical-align:baseline;white-space:pre-wrap\">REQUIRED QUALIFICATIONS:</span></p>\n<ul><li dir=\"ltr\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">High School Diploma or GED</span></li><li dir=\"ltr\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Current EMT or at least 2 years previous experience as an EMT or Current Nursing Assistant I listed with the NC</span><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\"><br /></span><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">DHSR Nurse Aide Registry.</span></li><li dir=\"ltr\">\n<p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Phlebotomy certification or complete phlebotomy training in NRH Laboratory within 3 months of employment.</span></p>\n</li><li dir=\"ltr\">\n<p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Current CPR certification or attained within 3 months of employment.</span></p>\n</li></ul>\n<p dir=\"ltr\" style=\"line-height:1.714284;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:underline;vertical-align:baseline;white-space:pre-wrap\">PREFERRED QUALIFICATIONS:</span></p>\n<ul><li dir=\"ltr\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Experience in patient care areas</span>\n<p dir=\"ltr\" style=\"line-height:1.714284;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt\">\u00a0</p>\n</li></ul>\n<p dir=\"ltr\" style=\"line-height:1.714284;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:bold;font-style:normal;font-variant:normal;text-decoration:underline;vertical-align:baseline;white-space:pre-wrap\">NURSING ASSISTANT I:</span><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:bold;font-style:normal;font-variant:normal;text-decoration:underline;vertical-align:baseline;white-space:pre-wrap\"><br /></span><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:underline;vertical-align:baseline;white-space:pre-wrap\">REQUIRED QUALIFICATIONS:</span></p>\n<ul><li dir=\"ltr\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Listed with DHSR Nurse Aide Registry as Nursing Assistant I</span></li><li><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Current CPR (or attained within 3 months of employment). </span></li></ul>\n<p dir=\"ltr\" style=\"line-height:1.714284;background-color:#ffffff;margin-top:0pt;margin-bottom:0pt\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:underline;vertical-align:baseline;white-space:pre-wrap\">PREFERRED QUALIFICATIONS: </span></p>\n<ul><li dir=\"ltr\"><span style=\"font-size:14pt;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap\">Previous emergency department NA experience</span></li></ul>"
